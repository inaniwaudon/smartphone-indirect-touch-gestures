# WebSocket server URL
VITE_WEBSOCKET_URL=ws://172.16.0.1
# Maximum number of trials
VITE_MAX_TRIAL=25
# Distance of the column from the initial position in the scrolling task
VITE_SCROLL_ROW_DISTANCE=30

# Time thresholds for gesture recognition (ms)
VITE_DOUBLE_TAP_TIME_THRESHOLD=400
VITE_LONG_PRESS_TIME_THRESHOLD=210
VITE_DRAGGING_TIME_THRESHOLD=950

# Range threshold for long press (px)
VITE_LONG_PRESS_RANGE_THRESHOLD=20
